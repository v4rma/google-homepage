 "recommended_core_features": [
  {
   "name": "temporal_alpha_log",
   "why": "largest effect; sign flips with expertise (experts: alpha higher on-task; novices: alpha higher during mind-wandering) - must be calibrated per wearer"
  },
  {
   "name": "temporal_ap_exponent",
   "why": "only feature with the same sign in all four groups (steeper 1/f during mind-wandering)"
  },
  {
   "name": "temporal_delta_log",
   "why": "broadband low-frequency rise during mind-wandering in 3/4 groups (drowsiness-like)"
  },
  {
   "name": "frontal_beta_log",
   "why": "rises during mind-wandering in 3/4 groups (arousal/EMG); drop if the wearer's frontal channels are noisy"
  },
  {
   "name": "temporal_theta_alpha_ratio",
   "why": "expertise-dependent, mirrors alpha; useful once the wearer's alpha sign is known"
  }
 ],
