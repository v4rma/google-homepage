 "score": {
  "formula": "score = sum_i weight_i * z_i, where z_i is the feature z-scored against the wearer's own running baseline (median/MAD over the last >= 5 min, or a calibration sit); positive = more on-task. Weights: default_weight_on_task, or by_expertise[profile].weight_on_task.",
  "profile_selection": "Use 'novice' unless the wearer has > ~1000 h of practice; the alpha and 1/f terms flip sign between profiles."
 },
 "calibration": {
  "required": true,
  "why": "LOSO AUC with raw features is close to chance; per-subject z-scoring recovers most of the within-subject separability (see expected_performance).",
  "procedure": "1) 10-15 min of normal meditation with ~8 probes (on-task vs MW self-report) to estimate per-feature mean/SD and, if possible, the wearer's sign for alpha; 2) refit weights with the pooled model as a prior once >= 20 labelled probes exist."
 },
 "expected_performance": {
  "note": "AUC/balanced accuracy for 60-s pre-probe windows, Muse-proximal channels, Fpz reference. 'loso' = leave-one-subject-out; 'within_subject' = stratified CV inside each subject with >= 5 probes per class. Chance = 0.5.",
  "logistic_regression_by_group": {
   "ds001787:all": {
    "best_feature_set_loso": "both_bands",
    "loso_auc_per_subject_zscored": 0.556,
    "loso_balanced_accuracy_per_subject_zscored": 0.543,
    "loso_auc_raw_features": 0.472,
    "within_subject_auc_mean": 0.621,
    "within_subject_balanced_accuracy_mean": 0.593,
    "n_epochs": 829
   },
   "ds001787:expert": {
    "best_feature_set_loso": "temporal_bands",
    "loso_auc_per_subject_zscored": 0.606,
    "loso_balanced_accuracy_per_subject_zscored": 0.576,
    "loso_auc_raw_features": 0.453,
    "within_subject_auc_mean": 0.618,
    "within_subject_balanced_accuracy_mean": 0.626,
    "n_epochs": 463
   },
   "ds001787:novice": {
