{
 "name": "fa_on_task_score",
 "version": "0.1.0-2026-10-15",
 "description": "Focused-attention (breath focus) vs mind-wandering score for Muse Athena EEG, derived from OpenNeuro ds001787 and OSF 3uszv restricted to Muse-proximal channels.",
 "target": {
  "positive_class": "on_task",
  "negative_class": "mind_wandering",
  "labels_source": "experience-sampling probes (ds001787: mind-wandering rating <=1 vs >=2; osf3uszv: 'focusing on breath' vs 'thinking about something else')"
 },
 "sampling_rate_hz": 256,
 "preprocessing": {
  "bandpass_hz": [
   0.5,
   45.0
  ],
  "notch_hz": [
   50,
   60
  ],
  "reference": "as recorded by Muse (Fpz); do not re-reference",
  "segment_s": 2.0,
  "segment_overlap": 0.5,
  "psd": "Welch, Hann, 2-s segments -> 0.5 Hz resolution",
  "artifact_rejection": {
   "per_channel_peak_to_peak_max_uv": 150,
   "flat_std_min_uv": 0.5,
   "min_fraction_segments_kept_per_channel": 0.5
  },
  "group_aggregation": "mean PSD across the group's channels, then features"
 },
 "window": {
  "length_s": 60,
  "hop_s": 5,
  "note": "Accuracy is flat from 30 to 60 s (see window_curve.csv); 30 s is acceptable when latency matters. Discard the first 10-15 s after any stimulus change."
 },
 "channel_groups": {
  "frontal": {
   "muse_channels": [
    "AF7",
    "AF8"
   ],
   "reference": "Fpz (device reference)",
   "source_proxies": {
