# Copy to .env (or export in your shell). Never commit a real key.

# "mock" (default when no key is set) or "openai" (any OpenAI-compatible chat-completions endpoint).
AVATAR_LLM_PROVIDER=mock

# Provider key is read ONLY from the environment; it is never stored in the database or logs.
OPENAI_API_KEY=

# Optional overrides for OpenAI-compatible providers.
AVATAR_LLM_MODEL=gpt-4o-mini
AVATAR_LLM_BASE_URL=https://api.openai.com/v1

# SQLite database path.
AVATAR_DB_PATH=data/avatar.db

# Diagnostic log level. Logs contain record IDs, stage names, sizes and error types only; never episode text.
AVATAR_LOG_LEVEL=INFO
