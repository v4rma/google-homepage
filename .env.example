# Copy to .env (or export in your shell). Never commit a real key.

# Provider: "agent" (default when no key is set) hands each analysis request to the Cursor project agent through
# a file inbox/outbox; "openai" (default when OPENAI_API_KEY is set) calls an OpenAI-compatible endpoint;
# "mock" is a keyword rule set for tests and offline plumbing checks (not a model).
AVATAR_LLM_PROVIDER=agent

# Agent bridge: requests go to <dir>/analysis-inbox/<id>.json, answers are read from <dir>/analysis-outbox/<id>.json.
AVATAR_AGENT_BRIDGE_DIR=data/agent-bridge
# Seconds a stage waits for the agent before the job is marked as not answered (the request stays in the inbox).
AVATAR_AGENT_TIMEOUT=120

# OpenAI-compatible provider. The key is read ONLY from the environment; it is never stored in the database or logs.
OPENAI_API_KEY=
AVATAR_LLM_MODEL=gpt-4o-mini
AVATAR_LLM_BASE_URL=https://api.openai.com/v1

# SQLite database path.
AVATAR_DB_PATH=data/avatar.db

# Diagnostic log level. Logs contain record IDs, stage names, sizes and error types only; never episode text.
AVATAR_LOG_LEVEL=INFO
