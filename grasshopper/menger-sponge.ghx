                <chunk name="Container">
                  <items count="9">
                    <item name="AdditionalSource" type_name="gh_string" type_code="10">
  // Menger sponge. A cell stays when, at every ternary digit, fewer than
  // two of its x/y/z digits are 1 (the open cross through each cube).
  private Mesh BuildMengerSponge(int iterations, double size)
  {
    Mesh sponge = new Mesh();
    if (size &lt;= 0.0 || iterations &lt; 0)
      return sponge;

    int cells = 1;
    for (int level = 0; level &lt; iterations; level++)
      cells *= 3;

    double cell = size / (double)cells;
    double origin = -0.5 * size;

    for (int ix = 0; ix &lt; cells; ix++)
    {
      for (int iy = 0; iy &lt; cells; iy++)
      {
        for (int iz = 0; iz &lt; cells; iz++)
        {
          if (!CellKept(ix, iy, iz, iterations))
            continue;

          double x = origin + ix * cell;
          double y = origin + iy * cell;
          double z = origin + iz * cell;
          AppendExposedFaces(sponge, x, y, z, cell, ix, iy, iz, cells, iterations);
        }
      }
    }

    sponge.Normals.ComputeNormals();
    sponge.Compact();
    return sponge;
  }

  private bool CellKept(int x, int y, int z, int iterations)
  {
    for (int level = 0; level &lt; iterations; level++)
    {
      int middles = 0;
      if (x % 3 == 1) middles++;
      if (y % 3 == 1) middles++;
      if (z % 3 == 1) middles++;
      if (middles &gt;= 2)
        return false;
      x /= 3;
      y /= 3;
      z /= 3;
    }
    return true;
  }

  private void AppendExposedFaces(Mesh sponge, double x, double y, double z, double s, int ix, int iy, int iz, int cells, int iterations)
  {
    if (!HasNeighbor(ix + 1, iy, iz, cells, iterations))
      AddQuad(sponge, x + s, y, z, x + s, y + s, z, x + s, y + s, z + s, x + s, y, z + s);
    if (!HasNeighbor(ix - 1, iy, iz, cells, iterations))
      AddQuad(sponge, x, y + s, z, x, y, z, x, y, z + s, x, y + s, z + s);
    if (!HasNeighbor(ix, iy + 1, iz, cells, iterations))
      AddQuad(sponge, x + s, y + s, z, x, y + s, z, x, y + s, z + s, x + s, y + s, z + s);
    if (!HasNeighbor(ix, iy - 1, iz, cells, iterations))
      AddQuad(sponge, x, y, z, x + s, y, z, x + s, y, z + s, x, y, z + s);
    if (!HasNeighbor(ix, iy, iz + 1, cells, iterations))
      AddQuad(sponge, x, y, z + s, x + s, y, z + s, x + s, y + s, z + s, x, y + s, z + s);
    if (!HasNeighbor(ix, iy, iz - 1, cells, iterations))
      AddQuad(sponge, x, y, z, x, y + s, z, x + s, y + s, z, x + s, y, z);
  }

  private bool HasNeighbor(int x, int y, int z, int cells, int iterations)
  {
    if (x &lt; 0 || y &lt; 0 || z &lt; 0 || x &gt;= cells || y &gt;= cells || z &gt;= cells)
      return false;
    return CellKept(x, y, z, iterations);
  }

  private void AddQuad(Mesh sponge, double x0, double y0, double z0, double x1, double y1, double z1, double x2, double y2, double z2, double x3, double y3, double z3)
  {
    int i = sponge.Vertices.Count;
    sponge.Vertices.Add(x0, y0, z0);
    sponge.Vertices.Add(x1, y1, z1);
    sponge.Vertices.Add(x2, y2, z2);
    sponge.Vertices.Add(x3, y3, z3);
    sponge.Faces.AddFace(i, i + 1, i + 2, i + 3);
  }
</item>
                    <item name="Description" type_name="gh_string" type_code="10">Builds a Menger sponge mesh from iteration count and size.</item>
                    <item name="EditorPosition" type_name="gh_drawing_point" type_code="30">
                      <X>80</X>
                      <Y>80</Y>
                    </item>
                    <item name="InstanceGuid" type_name="gh_guid" type_code="9">d44f3e54-7081-4d9e-bfa0-314253647586</item>
                    <item name="Name" type_name="gh_string" type_code="10">C# Script</item>
                    <item name="NickName" type_name="gh_string" type_code="10">Menger</item>
                    <item name="OutParameter" type_name="gh_bool" type_code="1">false</item>
                    <item name="ReferenceCount" type_name="gh_int32" type_code="3">0</item>
                    <item name="ScriptSource" type_name="gh_string" type_code="10">
    int n = System.Convert.ToInt32(iterations);
    double edge = System.Convert.ToDouble(size);
    if (n &lt; 0) n = 0;
    if (n &gt; 3) n = 3;
    if (edge &lt; 0.0) edge = 0.0;

    mesh = BuildMengerSponge(n, edge);
</item>
